---
// Janela de terminal da página inicial. Edite as linhas em `src/data/agora.ts`.
import { TERMINAL } from '../data/agora';
---

<div class="terminal" role="img" aria-label="Terminal com uma apresentação rápida de Henrique">
	<div class="barra">
		<span class="bolinhas" aria-hidden="true"><i></i><i></i><i></i></span>
		<span class="titulo">henrique@salvador: ~</span>
	</div>
	<pre>{TERMINAL.map((l) => l.cmd !== undefined ? (
		<span class="linha"><span class="prompt">$</span> <span class="cmd">{l.cmd}</span></span>
	) : (
		<span class="linha saida">{l.out}</span>
	))}<span class="linha"><span class="prompt">$</span> <span class="cursor" aria-hidden="true"></span></span></pre>
</div>

<style>
	.terminal {
		overflow: hidden;
		border-radius: 16px;
		background: var(--dark);
		color: var(--on-dark);
	}
	.barra {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 14px 20px;
		background: var(--dark-elevated);
	}
	.bolinhas {
		display: flex;
		gap: 6px;
	}
	.bolinhas i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #3a3733;
	}
	.titulo {
		color: var(--on-dark-soft);
		font-family: var(--font-mono);
		font-size: 12px;
	}
	pre {
		margin: 0;
		padding: 24px;
		white-space: pre-wrap;
		font-size: 14px;
		line-height: 1.75;
	}
	.linha {
		display: block;
	}
	.linha + .linha:not(.saida) {
		margin-top: 12px;
	}
	.prompt {
		color: var(--primary);
	}
	.cmd {
		color: var(--on-dark);
	}
	.saida {
		color: var(--on-dark-soft);
	}
	.cursor {
		display: inline-block;
		width: 8px;
		height: 1.1em;
		vertical-align: text-bottom;
		background: var(--teal);
		animation: piscar 1.1s steps(1) infinite;
	}
	@keyframes piscar {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
	@media (max-width: 640px) {
		pre {
			padding: 20px;
			font-size: 12.5px;
		}
	}
</style>
