---
import { GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="conteudo">
		<div class="assinatura">
			<p class="marca">{SITE_TITLE}<span>.</span></p>
			<p>Escrito em Salvador, Bahia, entre um commit e outro.</p>
		</div>
		<div class="coluna">
			<p class="titulo">Navegar</p>
			<a href="/">Início</a>
			<a href="/blog">Blog</a>
			<a href="/projetos">Projetos</a>
			<a href="/sobre">Sobre</a>
		</div>
		<div class="coluna">
			<p class="titulo">Contato</p>
			<a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
	<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}. Feito à mão com Astro.</p>
</footer>
<style>
	footer {
		background: var(--dark);
		color: var(--on-dark-soft);
		font-size: 14px;
	}
	.conteudo {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 48px;
		max-width: var(--max);
		margin: 0 auto;
		padding: 64px 24px 48px;
	}
	p {
		margin: 0;
	}
	.marca {
		margin-bottom: 8px;
		color: var(--on-dark);
		font-family: var(--font-serif);
		font-size: 1.75rem;
		letter-spacing: -0.02em;
	}
	.marca span {
		color: var(--primary);
	}
	.coluna {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.titulo {
		margin-bottom: 4px;
		color: var(--on-dark);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}
	a {
		color: var(--on-dark-soft);
		text-decoration: none;
	}
	a:hover {
		color: var(--on-dark);
	}
	.copy {
		max-width: var(--max);
		margin: 0 auto;
		padding: 24px;
		border-top: 1px solid var(--dark-elevated);
		font-size: 13px;
	}
	@media (max-width: 640px) {
		.conteudo {
			grid-template-columns: 1fr 1fr;
			gap: 32px;
			padding: 48px 16px 32px;
		}
		.assinatura {
			grid-column: 1 / -1;
		}
		.copy {
			padding: 24px 16px;
		}
	}
</style>
