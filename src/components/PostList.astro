---
// Lista de posts em linhas: data à esquerda, título e resumo à direita.
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import Icon from './Icon.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="posts">
	{posts.map((post) => (
		<li>
			<a href={`/blog/${post.id}/`} class="card interactive post">
				<span class="data">
					<FormattedDate date={post.data.pubDate} />
				</span>
				<span class="texto">
					<span class="titulo">{post.data.title}</span>
					<span class="resumo">{post.data.description}</span>
				</span>
				<span class="seta">
					<Icon name="arrow" size={18} />
				</span>
			</a>
		</li>
	))}
</ul>

<style>
	.posts {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post {
		display: grid;
		grid-template-columns: 10.5rem 1fr auto;
		align-items: center;
		gap: 1.25rem;
		padding: 1.1rem 1.4rem;
		color: inherit;
		text-decoration: none;
	}
	.data {
		color: var(--text-subtle);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		white-space: nowrap;
	}
	.texto {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}
	.titulo {
		color: var(--text);
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.resumo {
		color: var(--text-muted);
		font-size: 0.92rem;
	}
	.seta {
		display: grid;
		color: var(--text-subtle);
		transition:
			transform 0.2s ease,
			color 0.2s ease;
	}
	.post:hover .seta {
		transform: translateX(3px);
		color: var(--accent);
	}
	@media (max-width: 600px) {
		.post {
			grid-template-columns: 1fr auto;
			gap: 0.4rem 1rem;
		}
		.data {
			grid-column: 1 / -1;
		}
	}
</style>
