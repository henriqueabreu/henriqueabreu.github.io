---
// Lista de posts em estilo de índice: data, título pesado e resumo.
import type { CollectionEntry } from 'astro:content';
import { nomesDasCategorias } from '../lib/blog';
import FormattedDate from './FormattedDate.astro';
import Icon from './Icon.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	/** Faz cada post entrar suavemente ao rolar a página */
	revelar?: boolean;
}

const { posts, revelar = false } = Astro.props;
const nomeCategoria = await nomesDasCategorias();
---

<ul class="posts">
	{posts.map((post, i) => (
		<li class:list={{ revelar }} style={revelar ? `--i: ${i}` : undefined}>
			<a href={`/blog/${post.id}/`}>
				<span class="data">
					<FormattedDate date={post.data.pubDate} />
					{post.data.categoria && <span class="categoria">{nomeCategoria(post.data.categoria)}</span>}
				</span>
				<span class="texto">
					<span class="titulo">{post.data.title}</span>
					<span class="resumo">{post.data.description}</span>
				</span>
				<span class="seta" aria-hidden="true"><Icon name="arrow" size={20} /></span>
			</a>
		</li>
	))}
</ul>

<style>
	.posts {
		margin: 0;
		padding: 0;
		border-top: 3px solid var(--ink);
		list-style: none;
	}
	li {
		border-bottom: 2px solid var(--ink);
	}
	a {
		display: grid;
		grid-template-columns: 180px 1fr 40px;
		gap: 32px;
		padding: 28px 12px;
		color: inherit;
		text-decoration: none;
	}
	.data {
		padding-top: 8px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.categoria {
		display: block;
		margin-top: 4px;
		color: var(--primary-active);
	}
	.texto {
		display: grid;
		gap: 8px;
		max-width: 720px;
	}
	.titulo {
		color: var(--ink);
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: clamp(1.5rem, 2.4vw, 1.9rem);
		line-height: 1.15;
		letter-spacing: -0.035em;
		text-wrap: balance;
		transition: color var(--dur) var(--ease);
	}
	a:hover {
		background: var(--primary);
	}
	a:hover .titulo,
	a:hover .resumo,
	a:hover .data,
	a:hover .categoria,
	a:hover .seta {
		color: #0a0a0a;
	}
	.resumo {
		color: var(--muted);
	}
	.seta {
		align-self: center;
		justify-self: end;
		display: grid;
		color: var(--muted-soft);
		transition:
			transform var(--dur) var(--ease),
			color var(--dur) var(--ease);
	}
	a:hover .seta {
		color: var(--primary);
		transform: translateX(4px);
	}
	@media (max-width: 640px) {
		a {
			grid-template-columns: 1fr;
			gap: 8px;
			padding: 24px 0;
		}
		.data {
			padding: 0;
		}
		.categoria {
			display: inline;
			margin: 0 0 0 10px;
		}
		.seta {
			display: none;
		}
	}
</style>
