---
// Barra de categorias do blog: "Todos" + uma aba por categoria com posts.
interface Props {
	categorias: { slug: string; nome: string; total: number }[];
	total: number;
	/** Slug da categoria aberta; vazio na página "Todos" */
	atual?: string;
}

const { categorias, total, atual } = Astro.props;
---

<nav class="filtro" aria-label="Categorias">
	<a href="/blog/" class:list={{ ativa: !atual }} aria-current={!atual ? 'page' : undefined}>
		Todos <span>{total}</span>
	</a>
	{categorias.map((c) => (
		<a
			href={`/blog/categoria/${c.slug}/`}
			class:list={{ ativa: atual === c.slug }}
			aria-current={atual === c.slug ? 'page' : undefined}
		>
			{c.nome} <span>{c.total}</span>
		</a>
	))}
</nav>

<style>
	.filtro {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 12px;
		margin-bottom: 40px;
	}
	/* Categorias em caixas com borda; a aberta fica em bloco preto, como no menu */
	a {
		padding: 8px 12px;
		border: 2px solid var(--ink);
		color: var(--ink);
		font-size: 15px;
		font-weight: 700;
		line-height: 1.4;
		text-decoration: none;
	}
	a.ativa {
		background: var(--ink);
		color: var(--canvas);
	}
	a:hover {
		background: var(--primary);
		color: #0a0a0a;
	}
	a span {
		margin-left: 4px;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 400;
		opacity: 0.7;
		vertical-align: super;
	}
</style>
