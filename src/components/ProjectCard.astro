---
import type { Projeto } from '../data/projetos';

interface Props {
	projeto: Projeto;
}

const { projeto } = Astro.props;
---

<article class="projeto">
	<p class:list={['status', { ativo: projeto.status === 'Em andamento' }]}>{projeto.status}</p>
	<h3>
		{projeto.link ? (
			<a href={projeto.link} target="_blank" rel="noopener">{projeto.nome}</a>
		) : (
			projeto.nome
		)}
	</h3>
	<p class="descricao">{projeto.descricao}</p>
	<ul class="badges">
		{projeto.tecnologias.map((t) => <li class="badge">{t}</li>)}
	</ul>
</article>

<style>
	.projeto {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 32px;
		border: 1px solid var(--hairline);
		border-radius: 12px;
		background: var(--canvas);
	}
	.status {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 20px;
		color: var(--muted);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}
	.status::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--muted-soft);
	}
	.status.ativo::before {
		background: var(--teal);
	}
	h3 {
		margin-bottom: 12px;
	}
	h3 a {
		color: inherit;
	}
	.descricao {
		flex: 1;
		margin-bottom: 24px;
		color: var(--body);
	}
</style>
