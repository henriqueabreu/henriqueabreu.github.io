---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
---

<header>
	<nav>
		<a href="/" class="marca">{SITE_TITLE.toUpperCase()}<span class="ponto">■</span></a>
		<div class="direita">
			<div class="links">
				<HeaderLink href="/" class="inicio">Início</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/projetos">Projetos</HeaderLink>
				<HeaderLink href="/sobre">Sobre</HeaderLink>
			</div>
			<button type="button" id="alternar-tema" aria-label="Alternar tema claro/escuro">
				<span class="sol"><Icon name="sun" size={16} /></span>
				<span class="lua"><Icon name="moon" size={16} /></span>
			</button>
		</div>
	</nav>
</header>

<script>
	document.getElementById('alternar-tema')?.addEventListener('click', () => {
		const raiz = document.documentElement;
		const novo = raiz.dataset.theme === 'dark' ? 'light' : 'dark';
		raiz.dataset.theme = novo;
		try {
			localStorage.setItem('tema', novo);
		} catch {}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 3px solid var(--ink);
		background: var(--canvas);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		max-width: var(--max);
		height: 68px;
		margin: 0 auto;
		padding: 0 var(--gutter);
	}
	.marca {
		color: var(--ink);
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.4rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.ponto {
		color: var(--primary);
	}
	.direita {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.links {
		display: flex;
		gap: 4px;
	}
	button {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 2px solid var(--ink);
		background: transparent;
		color: var(--ink);
		transition:
			border-color var(--dur) var(--ease),
			transform 400ms var(--ease);
	}
	button:hover {
		background: var(--primary);
		color: #0a0a0a;
	}
	@media (prefers-reduced-motion: reduce) {
		button:hover {
			transform: none;
		}
	}
	button span {
		display: grid;
	}
	:global(:root[data-theme='dark']) .sol,
	:global(:root:not([data-theme='dark'])) .lua {
		display: none;
	}

	@media (max-width: 640px) {
		.marca {
			font-size: 0.9rem;
		}
		.direita {
			gap: 4px;
		}
		button {
			width: 32px;
			height: 32px;
		}
		.links {
			gap: 0;
		}
		.links :global(.inicio) {
			display: none;
		}
	}
</style>
