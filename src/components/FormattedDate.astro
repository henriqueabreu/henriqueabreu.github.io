---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString('pt-BR', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		// Datas do frontmatter viram meia-noite UTC; sem isso, no fuso do Brasil o post aparece um dia antes.
		timeZone: 'UTC',
	})}
</time>
