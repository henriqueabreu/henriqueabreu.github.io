---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import avatar from '../assets/avatar.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTOR, SITE_TITLE } from '../consts';
import { nomesDasCategorias } from '../lib/blog';
import { slugificar } from '../lib/slug';
import Layout from './Layout.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { id, title, description, pubDate, updatedDate, heroImage, categoria, tags } = Astro.props;
const nomeCategoria = await nomesDasCategorias();
---

<Layout title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage ?? `/og/${id}.png`}>
	<div class="progresso" aria-hidden="true"></div>
	<article>
		<header>
			<p class="topo">
				<a href="/blog" class="voltar">← Escritos</a>
				{categoria && <a href={`/blog/categoria/${categoria}/`} class="categoria">{nomeCategoria(categoria)}</a>}
			</p>
			<h1>{title}</h1>
			<p class="descricao">{description}</p>
			<div class="meta">
				<Image src={avatar} alt="" width={80} height={80} />
				<span>
					<strong>{AUTOR.nome}</strong>
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<>
							{' '}· atualizado em <FormattedDate date={updatedDate} />
						</>
					)}
				</span>
			</div>
		</header>
		{heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="capa" />}
		<div class="prose">
			<slot />
		</div>
		{tags.length > 0 && (
			<footer class="tags">
				<span class="caption">Assuntos</span>
				<ul class="badges">
					{tags.map((t) => (
						<li><a href={`/blog/tag/${slugificar(t)}/`} class="badge">{t}</a></li>
					))}
				</ul>
			</footer>
		)}
	</article>
</Layout>

<style>
	/* Barra fina de leitura no topo, guiada pela rolagem (só CSS; some onde não há suporte) */
	.progresso {
		display: none;
	}
	@supports (animation-timeline: scroll()) {
		.progresso {
			display: block;
			position: fixed;
			top: 0;
			right: 0;
			left: 0;
			z-index: 20;
			height: 6px;
			background: var(--primary);
			transform-origin: left;
			/* Propriedades separadas: o atalho `animation` zera a duração e a barra nasceria cheia */
			animation-name: ler;
			animation-duration: auto;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: scroll(root);
		}
	}
	@keyframes ler {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	/* Cabeçalho mais largo que o texto, como abertura de matéria */
	article {
		max-width: 880px;
		margin: 0 auto;
	}
	article > :not(header) {
		max-width: 680px;
		margin-right: auto;
		margin-left: auto;
	}
	header {
		margin-bottom: 56px;
		padding-bottom: 32px;
		border-bottom: 6px solid var(--ink);
	}
	h1 {
		font-size: clamp(2.5rem, 6vw, 4.25rem);
	}
	.topo {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 48px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.voltar {
		color: var(--muted);
		text-decoration: none;
	}
	.voltar:hover {
		color: var(--ink);
	}
	.categoria {
		color: var(--primary-active);
		text-decoration: none;
	}
	.tags {
		margin-top: 64px;
		padding-top: 32px;
		border-top: 1px solid var(--hairline);
	}
	.tags a {
		display: inline-block;
		text-decoration: none;
	}
	.descricao {
		max-width: 680px;
		margin-bottom: 36px;
		color: var(--muted);
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: clamp(1.2rem, 2vw, 1.45rem);
		line-height: 1.4;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.35;
	}
	.meta :global(img) {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}
	.meta strong {
		display: block;
		color: var(--ink);
		font-weight: 500;
	}
	article :global(.capa) {
		width: 100%;
		max-width: none;
		margin-bottom: 48px;
		border-radius: 12px;
	}
</style>
