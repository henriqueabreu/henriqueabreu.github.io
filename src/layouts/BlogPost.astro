---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import avatar from '../assets/avatar.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTOR, SITE_TITLE } from '../consts';
import { nomesDasCategorias } from '../lib/blog';
import { slugificar } from '../lib/slug';
import Layout from './Layout.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { id, title, description, pubDate, updatedDate, heroImage, categoria, tags } = Astro.props;
const nomeCategoria = await nomesDasCategorias();
---

<Layout title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage ?? `/og/${id}.png`}>
	<article>
		<header>
			<p class="topo">
				<a href="/blog" class="voltar">← Escritos</a>
				{categoria && <a href={`/blog/categoria/${categoria}/`} class="categoria">{nomeCategoria(categoria)}</a>}
			</p>
			<h1>{title}</h1>
			<p class="descricao">{description}</p>
			<div class="meta">
				<Image src={avatar} alt="" width={80} height={80} />
				<span>
					<strong>{AUTOR.nome}</strong>
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<>
							{' '}· atualizado em <FormattedDate date={updatedDate} />
						</>
					)}
				</span>
			</div>
		</header>
		{heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="capa" />}
		<div class="prose">
			<slot />
		</div>
		{tags.length > 0 && (
			<footer class="tags">
				<span class="caption">Assuntos</span>
				<ul class="badges">
					{tags.map((t) => (
						<li><a href={`/blog/tag/${slugificar(t)}/`} class="badge">{t}</a></li>
					))}
				</ul>
			</footer>
		)}
	</article>
</Layout>

<style>
	article {
		max-width: 680px;
		margin: 0 auto;
	}
	header {
		margin-bottom: 48px;
		padding-bottom: 32px;
		border-bottom: 1px solid var(--hairline);
	}
	.topo {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 40px;
		font-size: 14px;
	}
	.voltar {
		color: var(--muted);
		text-decoration: none;
	}
	.categoria {
		color: var(--primary-active);
		font-weight: 500;
		text-decoration: none;
	}
	.tags {
		margin-top: 64px;
		padding-top: 32px;
		border-top: 1px solid var(--hairline);
	}
	.tags a {
		display: inline-block;
		text-decoration: none;
	}
	.descricao {
		margin-bottom: 32px;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: 1.4rem;
		line-height: 1.4;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.35;
	}
	.meta :global(img) {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}
	.meta strong {
		display: block;
		color: var(--ink);
		font-weight: 500;
	}
	article :global(.capa) {
		width: 100%;
		margin-bottom: 48px;
		border-radius: 12px;
	}
</style>
