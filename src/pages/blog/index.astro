---
import FiltroBlog from '../../components/FiltroBlog.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import Layout from '../../layouts/Layout.astro';
import { categoriasEmUso, postsOrdenados, tagsEmUso } from '../../lib/blog';

const posts = await postsOrdenados();
const categorias = await categoriasEmUso(posts);
const tags = tagsEmUso(posts);
---

<Layout title={`Blog — ${SITE_TITLE}`} description="Textos sobre desenvolvimento de software, inteligência artificial e projetos.">
	<header class="page-header">
		<span class="caption">Blog</span>
		<h1><em>Escritos</em>.</h1>
		<p>Notas sobre desenvolvimento de software, inteligência artificial e o que estou aprendendo pelo caminho.</p>
	</header>
	<FiltroBlog categorias={categorias} total={posts.length} />
	<PostList posts={posts} />
	{tags.length > 0 && (
		<section class="tags">
			<span class="caption">Assuntos</span>
			<ul class="badges">
				{tags.map((t) => (
					<li><a href={`/blog/tag/${t.slug}/`} class="badge">{t.nome}</a></li>
				))}
			</ul>
		</section>
	)}
</Layout>

<style>
	.tags {
		margin-top: 64px;
	}
	.tags a {
		display: inline-block;
		text-decoration: none;
	}
</style>
