---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={`Blog — ${SITE_TITLE}`} description="Textos sobre desenvolvimento de software, inteligência artificial e projetos.">
	<header class="page-header">
		<span class="eyebrow">Blog</span>
		<h1>Escritos</h1>
		<p>Notas sobre desenvolvimento de software, inteligência artificial e o que estou aprendendo pelo caminho.</p>
	</header>
	<PostList posts={posts} />
</Layout>
