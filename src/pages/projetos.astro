---
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE } from '../consts';
import { PROJETOS } from '../data/projetos';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`Projetos — ${SITE_TITLE}`} description="Projetos em que trabalho ou trabalhei.">
	<header class="page-header">
		<span class="eyebrow">Projetos</span>
		<h1>O que estou construindo</h1>
		<p>Produtos, experimentos e estudos, a maioria girando em torno de agentes e IA aplicada.</p>
	</header>
	<div class="grade">
		{PROJETOS.map((p) => <ProjectCard projeto={p} />)}
	</div>
</Layout>

<style>
	.grade {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1rem;
	}
</style>
