---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentes = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Olá! 👋</h1>
			<p>
				<!-- Troque por uma apresentação sua, em duas ou três frases. -->
				Sou Henrique. Aqui escrevo sobre tecnologia, desenvolvimento de software e inteligência
				artificial, e registro os projetos em que estou trabalhando.
			</p>

			<h2>Posts recentes</h2>
			<ul>
				{recentes.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>{post.data.title}</a> —{' '}
						<FormattedDate date={post.data.pubDate} />
					</li>
				))}
			</ul>
			<p><a href="/blog">Ver todos os posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
