---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/avatar.jpg';
import Convite from '../components/Convite.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Terminal from '../components/Terminal.astro';
import { AUTOR, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { AGORA, AGORA_ATUALIZADO } from '../data/agora';
import { PROJETOS } from '../data/projetos';
import Layout from '../layouts/Layout.astro';

const recentes = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const destaques = PROJETOS.filter((p) => p.destaque).slice(0, 3);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div>
			<div class="autor">
				<Image src={avatar} alt="" width={96} height={96} loading="eager" />
				<span>
					<strong>{AUTOR.nome}</strong>
					{AUTOR.local}
				</span>
			</div>
			<h1>Software, agentes de IA e <em>pessoas</em>, trabalhando juntos.</h1>
			<p class="lead">
				Engenheiro de Computação formado pelo Instituto Federal do Ceará, com pós-graduação em
				Engenharia de IA Aplicada com ênfase em Engenharia de Software (em andamento). Construo
				software e venho explorando como agentes de inteligência artificial podem trabalhar lado a
				lado com pessoas em produtos de verdade.
			</p>
			<div class="ctas">
				<a href="/projetos" class="btn btn-primary">Ver projetos</a>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener" class="btn">
					<Icon name="linkedin" size={16} /> LinkedIn
				</a>
			</div>
		</div>
		<Terminal />
	</section>

	<section class="section agora">
		<div class="section-head">
			<h2>Agora</h2>
			<span class="atualizado">Atualizado em {AGORA_ATUALIZADO}</span>
		</div>
		<div class="agora-grade">
			{AGORA.map((a) => (
				<div class="agora-item">
					<span class="caption">{a.rotulo}</span>
					<h4>{a.titulo}</h4>
					<p>{a.texto}</p>
				</div>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section-head">
			<h2>Projetos</h2>
			<a href="/projetos">Todos os projetos</a>
		</div>
		<div class="grade">
			{destaques.map((p) => <ProjectCard projeto={p} />)}
		</div>
	</section>

	<section class="section">
		<div class="section-head">
			<h2>Escritos</h2>
			<a href="/blog">Todos os posts</a>
		</div>
		<PostList posts={recentes} />
	</section>

	<Convite />
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 64px;
	}
	.autor {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 32px;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.35;
	}
	.autor :global(img) {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		object-fit: cover;
	}
	.autor strong {
		display: block;
		color: var(--ink);
		font-weight: 500;
	}
	h1 {
		margin-bottom: 24px;
	}
	.lead {
		margin-bottom: 32px;
		color: var(--body);
		font-size: 1.125rem;
		line-height: 1.6;
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.agora {
		padding: 48px;
		border-radius: 12px;
		background: var(--surface-card);
	}
	.atualizado {
		color: var(--muted);
		font-size: 14px;
	}
	.agora-grade {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 40px;
	}
	.agora-item p {
		margin: 0;
	}

	.grade {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	@media (max-width: 1024px) {
		.grade {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
		}
		.agora-grade {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}
	@media (max-width: 640px) {
		.agora {
			padding: 32px 24px;
		}
		.agora .section-head {
			flex-direction: column;
			gap: 4px;
		}
		.grade {
			grid-template-columns: 1fr;
		}
	}
</style>
