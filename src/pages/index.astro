---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/avatar.jpg';
import Convite from '../components/Convite.astro';
import FibraOtica from '../components/FibraOtica.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AUTOR, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Terminal from '../components/Terminal.astro';
import { AGORA, AGORA_ATUALIZADO } from '../data/agora';
import { PROJETOS } from '../data/projetos';
import Layout from '../layouts/Layout.astro';

const recentes = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const destaques = PROJETOS.filter((p) => p.destaque).slice(0, 3);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero-faixa">
		<!-- Fibras num tom só, mais lentas, poucas e quase transparentes -->
		<FibraOtica cores={['#ff5a1f', '#ff5a1f', '#ff9a6e', '#ff5a1f']} fundo="#0a0a0a" fios={6} velocidade={0.35} />
		<div class="hero">
			<div>
				<div class="autor">
					<Image src={avatar} alt="" width={96} height={96} loading="eager" />
					<span>
						<strong>{AUTOR.nome}</strong>
						{AUTOR.local}
					</span>
				</div>
				<h1>Software, agentes de IA e <em>pessoas</em>, trabalhando juntos.</h1>
				<p class="lead">
					Mais de 12 anos entre código e produto. Hoje estudo e construo agentes de IA que trabalham lado
					a lado com pessoas.
				</p>
				<div class="ctas">
					<a href="/blog" class="btn btn-primary">
						Ver blog <span class="seta"><Icon name="arrow" size={16} /></span>
					</a>
					<a href={LINKEDIN_URL} target="_blank" rel="noopener" class="btn">
						<Icon name="linkedin" size={16} /> LinkedIn
					</a>
				</div>
			</div>
			<Terminal />
		</div>
	</section>

	<section class="section agora">
		<div class="section-head revelar">
			<h2>Agora</h2>
			<span class="atualizado">Atualizado em {AGORA_ATUALIZADO}</span>
		</div>
		<div class="agora-grade">
			{AGORA.map((a, i) => (
				<div class="agora-item revelar" style={`--i: ${i}`}>
					<span class="caption">{a.rotulo}</span>
					<h4>{a.titulo}</h4>
					<p>{a.texto}</p>
				</div>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section-head revelar">
			<h2>Projetos</h2>
			<a href="/projetos">Todos os projetos <Icon name="arrow" size={16} /></a>
		</div>
		<div class="grade">
			{destaques.map((p, i) => (
				<div class="revelar" style={`--i: ${i}`}>
					<ProjectCard projeto={p} grande={i === 0} />
				</div>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section-head revelar">
			<h2>Escritos</h2>
			<a href="/blog">Todos os posts <Icon name="arrow" size={16} /></a>
		</div>
		<PostList posts={recentes} revelar />
	</section>

	<Convite />
</Layout>

<style>
	/* Faixa preta chapada; as fibras ficam ao fundo, quase apagadas, sem véu em degradê */
	.hero-faixa {
		position: relative;
		width: 100vw;
		margin: -72px 0 0 calc(50% - 50vw);
		overflow: hidden;
		border-bottom: 6px solid var(--primary);
		background: #0a0a0a;
		color: #dcd9d0;
	}
	.hero-faixa :global(.fibra-otica.pronto) {
		opacity: 0.32;
	}
	.hero {
		position: relative;
		max-width: var(--max);
		margin: 0 auto;
		padding: clamp(80px, 11vw, 144px) var(--gutter);
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		align-items: center;
		gap: 64px;
	}
	.autor {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 32px;
		color: #b5b2a8;
		font-size: 14px;
		line-height: 1.35;
	}
	.autor :global(img) {
		width: 44px;
		height: 44px;
		border: 2px solid #f2f0e9;
		object-fit: cover;
	}
	.autor strong {
		display: block;
		color: #f2f0e9;
		font-weight: 700;
	}
	h1 {
		margin-bottom: 28px;
		color: #f2f0e9;
		font-size: clamp(2.75rem, 5.6vw, 4.75rem);
	}
	h1 em {
		color: #0a0a0a;
		line-height: 1.15;
	}
	.lead {
		max-width: 46ch;
		margin-bottom: 32px;
		color: #dcd9d0;
		font-size: 1.1875rem;
		line-height: 1.5;
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
	.ctas .btn-primary {
		border-color: #0a0a0a;
		box-shadow: 5px 5px 0 #f2f0e9;
	}
	.ctas .btn:not(.btn-primary) {
		border-color: #f2f0e9;
		background: #0a0a0a;
		color: #f2f0e9;
		box-shadow: 5px 5px 0 #f2f0e9;
	}
	.hero :global(.terminal) {
		border: 2px solid #f2f0e9;
		background: #0a0a0a;
		box-shadow: 8px 8px 0 #ff5a1f;
	}

	.atualizado {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
	}
	/* Três colunas separadas por filetes verticais, sem caixa em volta */
	.agora-grade {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}
	.agora-item {
		padding: 4px 32px 0;
		border-left: 3px solid var(--ink);
	}
	.agora-item:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.agora-item h4 {
		margin-bottom: 12px;
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.6rem;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}
	.agora-item p {
		margin: 0;
		color: var(--muted);
	}

	/* Projeto principal ocupa a coluna maior; os outros empilham ao lado */
	.grade {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: 20px;
	}
	.grade > :first-child {
		grid-row: span 2;
	}
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
			padding: 64px var(--gutter);
		}
		.agora-grade {
			grid-template-columns: 1fr;
		}
		.agora-item,
		.agora-item:first-child {
			padding: 24px 0;
			border-left: 0;
			border-top: 1px solid var(--hairline);
		}
		.agora-item:first-child {
			padding-top: 0;
			border-top: 0;
		}
		.grade {
			grid-template-columns: 1fr;
		}
		.grade > :first-child {
			grid-row: auto;
		}
	}
	@media (max-width: 640px) {
		.hero {
			padding: 48px var(--gutter);
		}
		.agora .section-head {
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
