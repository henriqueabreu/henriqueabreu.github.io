---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/avatar.jpg';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { AUTOR, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { PROJETOS } from '../data/projetos';
import Layout from '../layouts/Layout.astro';

const recentes = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const destaques = PROJETOS.filter((p) => p.destaque).slice(0, 3);

const areas = [
	{
		titulo: 'IA aplicada',
		texto: 'Agentes, RAG e LLMs colocados para resolver problemas reais de produto, não só demos.',
	},
	{
		titulo: 'Engenharia de software',
		texto: 'Sistemas web de ponta a ponta, do backend ao frontend, com foco em código que dá para manter.',
	},
	{
		titulo: 'Aprender em público',
		texto: 'Estudos construídos etapa por etapa e documentados aqui, com o que funcionou e o que não.',
	},
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-texto">
			<span class="selo"><span class="pulso" aria-hidden="true"></span>{AUTOR.status}</span>
			<h1>
				Olá, eu sou <span class="gradient-text">Henrique</span>.
			</h1>
			<p class="lead">
				{AUTOR.cargo} em {AUTOR.local}. Construo software e venho explorando como agentes de
				inteligência artificial podem trabalhar lado a lado com pessoas em produtos de verdade.
			</p>
			<div class="ctas">
				<a href="/projetos" class="btn btn-primary">Ver projetos <Icon name="arrow" size={18} /></a>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener" class="btn">
					<Icon name="linkedin" size={18} /> LinkedIn
				</a>
			</div>
		</div>
		<div class="hero-foto">
			<Image src={avatar} alt="Foto de Henrique Abreu" width={460} height={460} loading="eager" />
		</div>
	</section>

	<section class="areas">
		{areas.map((a, i) => (
			<div class="card area">
				<span class="numero">0{i + 1}</span>
				<h3>{a.titulo}</h3>
				<p>{a.texto}</p>
			</div>
		))}
	</section>

	<section class="bloco">
		<div class="section-head">
			<h2>Projetos em destaque</h2>
			<a href="/projetos">Todos os projetos →</a>
		</div>
		<div class="grade">
			{destaques.map((p) => <ProjectCard projeto={p} />)}
		</div>
	</section>

	<section class="bloco">
		<div class="section-head">
			<h2>Escritos recentes</h2>
			<a href="/blog">Todos os posts →</a>
		</div>
		<PostList posts={recentes} />
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 3rem;
		padding: 2.5rem 0 4rem;
	}
	.selo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1.5rem;
		padding: 0.35rem 0.9rem 0.35rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text-muted);
		font-size: 0.85rem;
		font-weight: 500;
	}
	.pulso {
		position: relative;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent-2);
	}
	.pulso::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--accent-2);
		animation: pulso 2s ease-out infinite;
	}
	@keyframes pulso {
		to {
			transform: scale(2.8);
			opacity: 0;
		}
	}
	h1 {
		font-size: clamp(2.6rem, 7vw, 4.25rem);
		letter-spacing: -0.04em;
		margin-bottom: 1.25rem;
	}
	.lead {
		max-width: 560px;
		margin-bottom: 2rem;
		color: var(--text-muted);
		font-size: 1.2rem;
		line-height: 1.6;
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.hero-foto {
		position: relative;
		padding: 6px;
		border-radius: 50%;
		background: var(--gradient);
		box-shadow: 0 20px 60px var(--glow-1);
	}
	.hero-foto img {
		display: block;
		width: 260px;
		height: 260px;
		border: 6px solid var(--bg);
		border-radius: 50%;
		object-fit: cover;
	}

	.areas {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-bottom: 5rem;
	}
	.area {
		padding: 1.5rem;
	}
	.numero {
		display: block;
		margin-bottom: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--accent);
	}
	.area h3 {
		font-size: 1.05rem;
		margin-bottom: 0.4rem;
	}
	.area p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.93rem;
	}

	.bloco {
		margin-bottom: 4.5rem;
	}
	.grade {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-top: 1rem;
		}
		.hero-foto {
			order: -1;
			justify-self: start;
		}
		.hero-foto img {
			width: 120px;
			height: 120px;
			border-width: 4px;
		}
		.hero-foto {
			padding: 4px;
		}
		.areas {
			grid-template-columns: 1fr;
			margin-bottom: 3.5rem;
		}
	}
</style>
