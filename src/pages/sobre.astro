---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import Convite from '../components/Convite.astro';
import { AUTOR, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import { FERRAMENTAS, TRAJETORIA } from '../data/trajetoria';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`Sobre — ${SITE_TITLE}`} description="Quem sou eu e o que faço.">
	<section class="intro">
		<div>
			<span class="caption">Sobre</span>
			<h1>Prazer, <em>Henrique</em>.</h1>
			<div class="prose">
				<!-- Ajuste este texto à vontade: é a sua apresentação. -->
				<p>
					Sou engenheiro de computação, formado pelo Instituto Federal do Ceará, e trabalho com
					desenvolvimento de software. Hoje curso uma pós-graduação em Engenharia de IA Aplicada com
					ênfase em Engenharia de Software, e meu foco tem sido inteligência artificial aplicada:
					agentes que dividem o trabalho com pessoas, sistemas de recuperação de informação (RAG) e o
					uso de LLMs no dia a dia de produto.
				</p>
				<p>
					Este site é onde registro esses estudos e projetos, com o que funcionou, o que não funcionou e
					por quê. Fora do código, sou pai do Vicente.
				</p>
				<p>
					Quer conversar? Me chame no <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a> ou
					veja o que ando publicando no <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>.
				</p>
			</div>
		</div>
		<figure>
			<Image src={avatar} alt="Foto de Henrique Abreu" width={460} height={460} />
			<figcaption>{AUTOR.cargo} · {AUTOR.local}</figcaption>
		</figure>
	</section>

	<section class="section colunas">
		<div>
			<h2>Trajetória</h2>
			<ol class="trajetoria">
				{TRAJETORIA.map((e) => (
					<li>
						<span class="periodo">{e.periodo}</span>
						<div>
							<h4>{e.titulo}</h4>
							<p class="lugar">{e.lugar}</p>
							{e.descricao && <p class="descricao">{e.descricao}</p>}
						</div>
					</li>
				))}
			</ol>
		</div>
		<aside class="ferramentas">
			<span class="caption">Ferramentas do dia a dia</span>
			<ul class="badges">
				{FERRAMENTAS.map((f) => <li class="badge">{f}</li>)}
			</ul>
		</aside>
	</section>

	<Convite />
</Layout>

<style>
	.intro {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 64px;
		align-items: start;
	}
	h1 {
		margin-bottom: 32px;
	}
	figure {
		margin: 0;
	}
	figure :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 16px;
		object-fit: cover;
	}
	figcaption {
		margin-top: 12px;
		color: var(--muted);
		font-size: 14px;
	}

	.colunas {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 64px;
		align-items: start;
	}
	.trajetoria {
		margin: 32px 0 0;
		padding: 0;
		border-top: 1px solid var(--hairline);
		list-style: none;
	}
	.trajetoria li {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 24px;
		padding: 24px 0;
		border-bottom: 1px solid var(--hairline);
	}
	.periodo {
		color: var(--muted);
		font-size: 14px;
		padding-top: 2px;
	}
	.trajetoria h4 {
		margin-bottom: 2px;
	}
	.lugar {
		margin: 0;
		color: var(--muted);
	}
	.descricao {
		margin: 8px 0 0;
	}
	.ferramentas {
		padding: 32px;
		border-radius: 12px;
		background: var(--surface-card);
	}
	.ferramentas .badge {
		background: var(--canvas);
	}

	@media (max-width: 860px) {
		.intro,
		.colunas {
			grid-template-columns: 1fr;
			gap: 48px;
		}
		figure {
			order: -1;
			max-width: 240px;
		}
	}
	@media (max-width: 520px) {
		.trajetoria li {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
