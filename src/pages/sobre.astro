---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import Convite from '../components/Convite.astro';
import { AUTOR, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import { CERTIFICACOES, COMO_TRABALHO, FERRAMENTAS, TRAJETORIA } from '../data/trajetoria';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`Sobre — ${SITE_TITLE}`} description="Engenheiro de Computação com mais de 12 anos entre desenvolvimento e produto, hoje focado em IA aplicada.">
	<section class="intro">
		<div>
			<span class="caption">Sobre</span>
			<h1>Prazer, <em>Henrique</em>.</h1>
			<div class="prose">
				<!-- Ajuste este texto à vontade: é a sua apresentação. -->
				<p>
					Sou engenheiro de computação, formado pelo Instituto Federal do Ceará, e há mais de 12 anos
					trabalho entre o código e o produto. Fui desenvolvedor, Product Owner e Product Manager, quase
					sempre em sistemas financeiros: contas a pagar e a receber, integração com bancos, migração de
					sistemas legados e as APIs que ligam uma ponta à outra.
				</p>
				<p>
					Sou certificado PSM I (Professional Scrum Master) pela Scrum.org, mas o que mais me interessa em
					agilidade é o efeito nas pessoas: times que entregam valor de verdade e, no caminho, ficam
					tecnicamente melhores e mais autônomos.
				</p>
				<p>
					Hoje curso uma pós-graduação em Engenharia de IA Aplicada com ênfase em Engenharia de Software,
					e meu foco tem sido inteligência artificial aplicada: agentes que dividem o trabalho com pessoas,
					sistemas de recuperação de informação (RAG) e o uso de LLMs no dia a dia de produto. Este site é
					onde registro esses estudos e projetos, com o que funcionou, o que não funcionou e por quê. Fora
					do código, sou pai do Vicente.
				</p>
				<p>
					Quer conversar? Me chame no <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a> ou
					veja o que ando publicando no <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>.
				</p>
			</div>
		</div>
		<figure>
			<Image src={avatar} alt="Foto de Henrique Abreu" width={460} height={460} />
			<figcaption>{AUTOR.cargo} · {AUTOR.local}</figcaption>
		</figure>
	</section>

	<section class="section como">
		<div class="section-head revelar">
			<h2>Como trabalho</h2>
		</div>
		<p class="objetivo revelar">
			Quero continuar ajudando times a chegar ao seu melhor, liderando projetos que resolvam problemas
			reais e entreguem valor de verdade para as empresas e seus processos.
		</p>
		<div class="como-grade">
			{COMO_TRABALHO.map((c, i) => (
				<div class="como-item revelar" style={`--i: ${i % 2}`}>
					<span class="caption">{c.rotulo}</span>
					<h4>{c.titulo}</h4>
					<p>{c.texto}</p>
				</div>
			))}
		</div>
	</section>

	<section class="section colunas">
		<div>
			<h2>Trajetória</h2>
			<ol class="trajetoria">
				{TRAJETORIA.map((e) => (
					<li class="revelar">
						<span class="periodo">{e.periodo}</span>
						<div>
							<h4>{e.titulo}</h4>
							<p class="lugar">{e.lugar}</p>
							{e.descricao && <p class="descricao">{e.descricao}</p>}
						</div>
					</li>
				))}
			</ol>
		</div>
		<aside class="ferramentas">
			<span class="caption">Ferramentas do dia a dia</span>
			<ul class="badges">
				{FERRAMENTAS.map((f) => <li class="badge">{f}</li>)}
			</ul>
			<span class="caption certificacao">Certificação</span>
			<ul class="badges">
				{CERTIFICACOES.map((c) => <li class="badge">{c}</li>)}
			</ul>
		</aside>
	</section>

	<Convite />
</Layout>

<style>
	.intro {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 64px;
		align-items: start;
	}
	h1 {
		margin-bottom: 32px;
	}
	figure {
		margin: 0;
	}
	figure :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border-radius: 16px;
		object-fit: cover;
	}
	figcaption {
		margin-top: 14px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.colunas {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 64px;
		align-items: start;
	}
	.trajetoria {
		margin: 32px 0 0;
		padding: 0;
		border-top: 1px solid var(--ink);
		list-style: none;
	}
	.trajetoria li {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 24px;
		padding: 24px 0;
		border-bottom: 1px solid var(--hairline);
	}
	.periodo {
		padding-top: 4px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
	}
	.trajetoria h4 {
		margin-bottom: 4px;
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 1.4rem;
		
		letter-spacing: -0.01em;
	}
	.lugar {
		margin: 0;
		color: var(--muted);
	}
	.descricao {
		margin: 8px 0 0;
	}
	.ferramentas {
		padding: 32px;
		border-radius: 12px;
		background: var(--surface-card);
	}
	.ferramentas .badge {
		background: var(--canvas);
	}

	.objetivo {
		max-width: 720px;
		margin-bottom: 48px;
		color: var(--body);
		font-size: 1.1875rem;
		line-height: 1.55;
	}
	.como-grade {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0 48px;
	}
	.como-item {
		padding: 28px 0;
		border-top: 1px solid var(--hairline);
	}
	.como-item h4 {
		margin-bottom: 8px;
		font-family: var(--font-sans);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.2;
	}
	.como-item p {
		margin: 0;
		color: var(--muted);
	}
	.certificacao {
		margin-top: 28px;
	}

	@media (max-width: 860px) {
		.como-grade {
			grid-template-columns: 1fr;
		}
		.intro,
		.colunas {
			grid-template-columns: 1fr;
			gap: 48px;
		}
		figure {
			order: -1;
			max-width: 240px;
		}
	}
	@media (max-width: 520px) {
		.trajetoria li {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
