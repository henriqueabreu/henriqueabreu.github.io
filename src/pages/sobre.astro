---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import Icon from '../components/Icon.astro';
import { AUTOR, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import { FERRAMENTAS, TRAJETORIA } from '../data/trajetoria';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`Sobre — ${SITE_TITLE}`} description="Quem sou eu e o que faço.">
	<section class="intro">
		<Image src={avatar} alt="Foto de Henrique Abreu" width={320} height={320} class="foto" />
		<div>
			<span class="eyebrow">Sobre</span>
			<h1>{AUTOR.nome}</h1>
			<p class="local"><Icon name="pin" size={16} /> {AUTOR.local} · {AUTOR.cargo}</p>
		</div>
	</section>

	<div class="colunas">
		<div class="prose">
			<!-- Ajuste este texto à vontade: é a sua apresentação. -->
			<p>
				Sou engenheiro de computação e trabalho com desenvolvimento de software. Nos últimos tempos,
				meu foco tem sido inteligência artificial aplicada: agentes que dividem o trabalho com pessoas,
				sistemas de recuperação de informação (RAG) e o uso de LLMs no dia a dia de produto.
			</p>
			<p>
				Este site é onde registro esses estudos e projetos, com o que funcionou, o que não funcionou e
				por quê. Fora do código, sou pai do Vicente.
			</p>
			<p>
				Quer conversar? Me chame no <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a> ou
				veja o que ando publicando no <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>.
			</p>
		</div>

		<aside class="card ferramentas">
			<h3>Ferramentas do dia a dia</h3>
			<ul class="chips">
				{FERRAMENTAS.map((f) => <li class="chip">{f}</li>)}
			</ul>
		</aside>
	</div>

	<section class="trajetoria">
		<h2>Trajetória</h2>
		<ol>
			{TRAJETORIA.map((e) => (
				<li>
					<span class="periodo">{e.periodo}</span>
					<div>
						<h3>{e.titulo}</h3>
						<p class="lugar">{e.lugar}</p>
						{e.descricao && <p class="descricao">{e.descricao}</p>}
					</div>
				</li>
			))}
		</ol>
	</section>
</Layout>

<style>
	.intro {
		display: flex;
		align-items: center;
		gap: 2rem;
		margin-bottom: 3rem;
	}
	.intro :global(.foto) {
		flex-shrink: 0;
		width: 120px;
		height: 120px;
		border-radius: 28px;
		object-fit: cover;
		box-shadow: 0 0 0 4px var(--bg), 0 0 0 6px var(--accent), var(--shadow);
	}
	.intro h1 {
		margin-bottom: 0.25rem;
	}
	.local {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: var(--text-muted);
	}

	.colunas {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 3rem;
		align-items: start;
		margin-bottom: 4.5rem;
	}
	.ferramentas {
		padding: 1.5rem;
	}
	.ferramentas h3 {
		font-size: 1rem;
		margin-bottom: 1rem;
	}

	.trajetoria h2 {
		margin-bottom: 2rem;
	}
	.trajetoria ol {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 720px;
	}
	.trajetoria ol::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 6.25rem;
		width: 1px;
		background: var(--border);
	}
	.trajetoria li {
		position: relative;
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 2rem;
		padding-bottom: 2rem;
	}
	.trajetoria li::before {
		content: '';
		position: absolute;
		top: 0.45rem;
		left: calc(6.25rem - 5px);
		width: 11px;
		height: 11px;
		border: 2px solid var(--accent);
		border-radius: 50%;
		background: var(--bg);
	}
	.periodo {
		padding-top: 0.1rem;
		color: var(--text-subtle);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-align: right;
	}
	.trajetoria li h3 {
		margin-bottom: 0.15rem;
		font-size: 1.05rem;
	}
	.lugar {
		margin: 0;
		color: var(--accent);
		font-size: 0.93rem;
		font-weight: 500;
	}
	.descricao {
		margin: 0.4rem 0 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	@media (max-width: 820px) {
		.colunas {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
	@media (max-width: 520px) {
		.intro {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}
		.trajetoria ol::before {
			left: 5px;
		}
		.trajetoria li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
			padding-left: 1.75rem;
		}
		.trajetoria li::before {
			left: 0;
		}
		.periodo {
			text-align: left;
		}
	}
</style>
